# PostgreSQL (fourni par Coolify en production).
# En local, laisser vide : une base PGlite est créée dans .data/pglite.
DATABASE_URL=

# Clé de chiffrement des cookies de session, 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Dossier des photos de recettes (volume persistant en production).
UPLOAD_DIR=./.data/uploads

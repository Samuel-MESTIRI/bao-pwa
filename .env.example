# PostgreSQL (fourni par Coolify en production).
# En local, laisser vide : une base PGlite est créée dans .data/pglite.
DATABASE_URL=

# Clé de chiffrement des cookies de session, 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Dossier des photos de recettes (volume persistant en production).
UPLOAD_DIR=./.data/uploads

# Scan magique (photo d'une page de recette → formulaire pré-rempli).
# Clé créée dans Google AI Studio (aistudio.google.com). Sans clé, le bouton est masqué.
GEMINI_API_KEY=
# Facultatif : modèle utilisé (par défaut l'alias tenu à jour par Google).
GEMINI_MODEL=gemini-flash-lite-latest
